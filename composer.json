{
    "name": "moho/payment-gateways",
    "description": "Hosted payment page gateways for Macedonian payment providers (cPay/Casys, NLB/Bankart, Halkbank/NestPay), built for Cream ERP.",
    "type": "library",
    "keywords": [
        "payment",
        "payment-gateway",
        "cpay",
        "casys",
        "nlb",
        "bankart",
        "halkbank",
        "nestpay",
        "macedonia",
        "mkd",
        "cream-erp"
    ],
    "homepage": "https://cream.mk",
    "license": "MIT",
    "authors": [
        {
            "name": "Moho",
            "homepage": "https://moho.mk"
        }
    ],
    "support": {
        "issues": "https://github.com/mohomk/payment-gateways/issues",
        "source": "https://github.com/mohomk/payment-gateways",
        "security": "https://github.com/mohomk/payment-gateways/security/policy"
    },
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Moho\\PaymentGateways\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Moho\\PaymentGateways\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
